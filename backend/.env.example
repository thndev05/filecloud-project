# Local dev without Docker: copy to .env. On the VPS, values come from ../.env via docker-compose.yml
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filecloud?schema=public"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# On the VPS: MINIO_ENDPOINT=s3.<domain>, MINIO_PORT=443, MINIO_USE_SSL=true
# (presigned share links must use a host the browser can reach)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=filecloud

# CORS origin + base URL for share links
FRONTEND_URL=http://localhost:5173
